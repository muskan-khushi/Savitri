# ────────────────────────────────────────────────────────────────
# Savitri Backend — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git (it is already in .gitignore).
# ────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────
# For local dev, SQLite is used automatically (no config needed).
# For production (Supabase/Neon), set this Postgres URL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/savitri

# ── Telegram Bot ────────────────────────────────────────────────
# Get a token from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Agmarknet / data.gov.in ─────────────────────────────────────
# Register at https://data.gov.in and get a free API key:
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# ── Bhashini / ULCA ─────────────────────────────────────────────
# Register at https://bhashini.gov.in/ulca to get these:
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here

# ── Disease Detection Model ──────────────────────────────────────
# Path to the trained MobileNetV2 checkpoint.
# Default: ml/checkpoints/mobilenetv2_plantvillage_best.pth
# Override only if you save the checkpoint elsewhere:
# DISEASE_MODEL_CHECKPOINT=/path/to/your/checkpoint.pth

# ── Copernicus (Sentinel-2, optional) ───────────────────────────
# For real Sentinel-2 NDVI (instead of the Open-Meteo soil moisture
# proxy). Register at https://dataspace.copernicus.eu:
# COPERNICUS_CLIENT_ID=your_copernicus_client_id
# COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# ── CORS (production) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev, leave unset (defaults to localhost:3000):
# ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://savitri.in
